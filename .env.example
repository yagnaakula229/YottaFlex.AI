APP_NAME=YottaFlex AI
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME_TEST
DATABASE_CONNECT_TIMEOUT_SECONDS=5
SCENARIO_AS_OF=2026-10-22T00:00:00+00:00
RECOVERY_POLICY_VERSION=recovery-v1-provisional
ABANDONED_CART_INACTIVITY_MINUTES=60
RECOVERY_FREQUENCY_CAP_24H=1
RECOVERY_FREQUENCY_CAP_7D=3
RECOVERY_ROLLING_WINDOW_BOUNDARY=(lower, upper]
RECOVERY_ROLLING_WINDOW_BOUNDARY=(lower, upper]
RECOVERY_PURCHASE_BLOCKING_STATUSES=["pending","paid","refunded"]
RECOVERY_QUALIFYING_CART_EVENT_TYPES=["cart_created","cart_activity","cart_line_added","cart_line_updated","cart_line_removed"]
RECOVERY_QUALIFYING_ATTEMPT_STATES=["accepted"]
RECOVERY_CONVERSION_WINDOW_DAYS=7
RECOVERY_CAMPAIGN_SELECTION_POLICY=campaign-id-priority-template-id-v1
RECOVERY_USE_CART_UPDATED_AT_FALLBACK=true